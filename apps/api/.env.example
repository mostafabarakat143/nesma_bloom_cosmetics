# Copy to apps/api/.env for local development (never commit .env)

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origin(s) for CORS (comma-separated).
# Dev Next.js example:
CORS_ORIGIN=http://localhost:3000

BODY_SIZE_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

DATABASE_URL=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom?schema=public

# Dedicated DB for integration tests (never point at production).
DATABASE_URL_TEST=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom_test?schema=public

# Auth — use long random secrets in real environments
JWT_ACCESS_SECRET=dev-only-change-me-to-a-long-random-secret
# Bearer JWT lifetime (seconds). Default 7 days.
JWT_TTL_SECONDS=604800
JWT_ISSUER=nesma-bloom-api
JWT_AUDIENCE=nesma-bloom-clients
# Password reset link lifetime (seconds). Default 30 minutes.
PASSWORD_RESET_TTL_SECONDS=1800
# Origin used in the reset link. The raw token is never stored or returned by the API.
APP_PUBLIC_URL=http://localhost:3000

# Uploaded catalog and profile images. Relative paths resolve from the API working directory.
# Stored URLs use API_PUBLIC_URL (origin only, no path). Files are not kept in PostgreSQL.
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:4000

# Password reset email. Leave all blank to print the link in the development log instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER and SMTP_FROM are the Gmail address,
# SMTP_PASS is a Google App Password (not the normal Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# API docs (/api/docs, /api/openapi.json). Default: on in development/test, off in production.
# ENABLE_API_DOCS=true
