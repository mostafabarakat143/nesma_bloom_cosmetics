# Copy to .env for local development (never commit .env)
# Load with: set variables in your shell, or:
#   node --env-file=.env ...
#   pnpm exec tsx --env-file=.env src/server.ts

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS.
# Leave empty to disable CORS (suitable until the Next.js app exists).
# Example for local frontend:
# CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=

# express.json body size limit
BODY_SIZE_LIMIT=100kb

# Rate limiting (skipped automatically when NODE_ENV=test)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
