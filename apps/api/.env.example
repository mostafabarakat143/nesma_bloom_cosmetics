NODE_ENV=development
PORT=4000
LOG_LEVEL=info

CORS_ORIGIN=http://localhost:3000

BODY_SIZE_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

DATABASE_URL=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom?schema=public

DATABASE_URL_TEST=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom_test?schema=public

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=cosmetics:api
CACHE_TTL_SECONDS=30

JWT_ACCESS_SECRET=dev-only-change-me-to-a-long-random-secret

JWT_TTL_SECONDS=604800
JWT_ISSUER=nesma-bloom-api
JWT_AUDIENCE=nesma-bloom-clients

PASSWORD_RESET_TTL_SECONDS=1800

APP_PUBLIC_URL=http://localhost:3000

UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:4000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
