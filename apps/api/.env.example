# Copy to apps/api/.env for local development (never commit .env)
# Load via dotenv (server + Prisma CLI) or:
#   node --env-file=.env ...

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS.
# Leave empty to disable CORS (suitable until the Next.js app exists).
# Example for local frontend:
# CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=

# express.json body size limit
BODY_SIZE_LIMIT=100kb

# Rate limiting (skipped automatically when NODE_ENV=test)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# PostgreSQL connection for Prisma CLI + Express API.
# Must match credentials in infra/.env used by Docker Compose.
# Example (placeholders only — replace password):
# DATABASE_URL=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom?schema=public
DATABASE_URL=postgresql://nesma:change_me@127.0.0.1:5432/nesma_bloom?schema=public
